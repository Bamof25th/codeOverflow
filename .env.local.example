# NextAuth (Auth.js v5)
# Generate a secret with: npx auth secret
AUTH_SECRET=your_auth_secret_here

# GitHub OAuth
# Create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_github_oauth_client_id_here
AUTH_GITHUB_SECRET=your_github_oauth_client_secret_here

# TinyMCE Editor
NEXT_PUBLIC_TINY_EDITOR_KEY=your_tiny_editor_key_here

# MongoDB
MONGODB_URL=your_mongodb_connection_string_here

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Eden AI
EDENAI_API_KEY=your_edenai_api_key_here
